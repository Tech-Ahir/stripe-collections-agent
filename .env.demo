# ----------------------------------------------------------------------------------
# DEMO CONFIGURATION
#
# You do not need to edit this file by hand. Run this instead, and it will ask you for
# the three values below and fill them in for you:
#
#   ./scripts/setup-demo.sh
#
# Everything else here is already set correctly. Do not change it.
#
# Stripe TEST MODE only. There is no live-key code path anywhere in this system, and the
# email adapter captures every letter to your own disk, so running this demo cannot
# email a real person or move real money.
# ----------------------------------------------------------------------------------

# --- THE THREE VALUES YOU SUPPLY --------------------------------------------------

# 1. Your Anthropic API key. This is the only one that is yours.
#    Get one at https://console.anthropic.com  ->  API keys.
#    It bills to your account, which is why it is not shipped in this file.
#
#    Without it, the app still runs and the whole approval flow is reviewable — the
#    agent simply cannot think. See "No Anthropic key yet?" in the README.
ANTHROPIC_API_KEY=

# 2 and 3. The Stripe sandbox keys, sent to you separately alongside your invitation to
#    this repository. They belong to a sandbox created solely for this evaluation.
#    Paste them here, or let scripts/setup-demo.sh ask you for them.
#
#    They are deliberately not committed. A key in git history stays in git history
#    even after it is rotated, so they travel with the invitation instead.

#    The agent service's key. RESTRICTED and read-only — read on Invoices, Customers
#    and Test clocks, nothing else. A write attempt with it returns 403 from Stripe.
STRIPE_API_KEY_READ=

#    The seeding script's key, run by hand and never by a running service. It needs
#    write access to create the demo customers and invoices. app/guards.py refuses to
#    start the agent service if this key is ever visible to it.
STRIPE_API_KEY_SEED=

# --- GENERATED FOR YOU ------------------------------------------------------------

# 32 random bytes, shared by the two services and by nothing else. It is what makes an
# approval token unforgeable. scripts/setup-demo.sh generates one. By hand:
#   openssl rand -hex 32
APPROVAL_SIGNING_SECRET=

# --- ALREADY CORRECT — leave these alone ------------------------------------------

# Captures every letter to the database and /data/outbox. Nothing leaves your machine.
EMAIL_ADAPTER=outbox
MAIL_FROM=collections@servicia.ai

# The gateway's write path, deliberately off, and its key deliberately empty. The demo
# never needs it, and an unused write credential is one more thing to lose.
STRIPE_API_KEY_WRITE=
ENABLE_STRIPE_INVOICE_SEND=false

# Required for the deep-overdue invoices. Stripe refuses a back-dated due_date, so the
# 47-, 62- and 95-day invoices can only exist on a test clock. Switch this off and they
# vanish from the queue.
STRIPE_INCLUDE_TEST_CLOCK_INVOICES=true

ANTHROPIC_MODEL=claude-sonnet-5
OPERATOR_ID=operator@servicia.ai
LOG_LEVEL=INFO
