# ----------------------------------------------------------------------------------
# Stripe Collections Agent -- local configuration
#
#   cp .env.example .env    then fill in the three required values below.
#
# Test mode only. There is no live-key code path in this system.
# ----------------------------------------------------------------------------------

# --- REQUIRED ---------------------------------------------------------------------

# Agent service. A RESTRICTED key, read-only on Invoices, Customers and Charges.
# Create one at: Stripe Dashboard -> Developers -> API keys -> Restricted keys.
# A standard sk_test_... key will work, but the read-only split is the point, so use a
# restricted key for anything you intend to show a reviewer. /healthz reports which
# kind of key it was given.
STRIPE_API_KEY_READ=rk_test_replace_me

# Agent service. Needed to run the agent loop.
ANTHROPIC_API_KEY=sk-ant-replace_me

# Shared by the two services and by nothing else. 32+ bytes.
#   python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SIGNING_SECRET=replace_me_with_64_hex_characters_at_least_32_bytes_long_xxxxxxxx

# --- SEEDING (run by a human, never by a service) ---------------------------------

# scripts/seed_stripe_test_data.py needs write access to create test customers and
# invoices. This is your standard sk_test_... key. No service ever reads it.
STRIPE_API_KEY_SEED=sk_test_replace_me

# --- GATEWAY ONLY -----------------------------------------------------------------

# Required only if ENABLE_STRIPE_INVOICE_SEND is true. Never present in the app service.
STRIPE_API_KEY_WRITE=
ENABLE_STRIPE_INVOICE_SEND=false

# outbox | smtp | resend.
#   outbox  (default) captures the letter in the database and /data/outbox. Nothing
#           leaves the machine, so cloning this repo cannot email a real person.
#   smtp    point at Mailpit: docker compose --profile smtp up -d
#   resend  real delivery. Requires RESEND_API_KEY. Off by default, deliberately.
EMAIL_ADAPTER=outbox
MAIL_FROM=collections@servicia.ai

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# --- TUNING -----------------------------------------------------------------------

ANTHROPIC_MODEL=claude-sonnet-5
PROPOSAL_TTL_HOURS=72
MAX_TOOL_CALLS_PER_RUN=25
MAX_PROPOSALS_PER_RUN=10

# Stripe refuses a back-dated due_date, at creation and on update alike, so a genuinely
# 95-days-overdue invoice can only exist in test mode on a TEST CLOCK -- and objects on a
# test clock are omitted from unfiltered list calls, while invoices.list offers no
# test_clock filter. With this on, the overdue query is additionally run scoped to each
# test-clock customer using the identical server-side status and due_date filters, which is
# what makes scripts/seed_stripe_test_data.py visible to the agent. Nothing is paged and
# filtered in Python. Harmless in live mode, where no test clocks exist.
STRIPE_INCLUDE_TEST_CLOCK_INVOICES=true
OPERATOR_ID=operator@servicia.ai
LOG_LEVEL=INFO

# --- ADVANCED (sensible defaults; listed so nothing is configurable-but-undocumented) ---

# Ceiling on a single model request. A wedged call fails the run with a readable reason
# instead of holding a worker and leaving the run at "running" until a restart.
RUN_TIMEOUT_SECONDS=600

# How long the app waits on the gateway before reporting it unreachable.
GATEWAY_TIMEOUT_SECONDS=30

# How many agent runs may execute at once. Two is plenty for one operator and keeps SQLite
# write contention where the retry logic can absorb it.
MAX_CONCURRENT_RUNS=2

# How long a minted approval token stays valid. Section 5 of the brief says fifteen minutes.
APPROVAL_TOKEN_TTL_SECONDS=900

# The "Try to send without approval" button (step 4 of the handoff demo). It mints a
# correctly signed token for a proposal nobody approved, so the gateway refuses it at
# check 4 rather than at the signature check.
ENABLE_UNAPPROVED_ATTEMPT_DEMO=true

# Display name on outgoing letters, and whether the SMTP adapter negotiates STARTTLS.
MAIL_FROM_NAME=Servicia Collections
SMTP_STARTTLS=false

# Set by docker-compose.yml, not here: DATABASE_URL, GATEWAY_URL, OUTBOX_DIR.
