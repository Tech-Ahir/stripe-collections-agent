# Secrets — never commit. The real keys live only in .env, which stays local.
.env
.env.*
!.env.example
# .env.demo is the one deliberate exception, and it holds NO credentials. It carries the
# demo's settings with the three secret values left blank; scripts/setup-demo.sh fills
# them in locally. The Stripe sandbox keys travel with the repository invitation instead,
# because a key committed to git stays in the history even after it is rotated.
!.env.demo

# Local data volume / SQLite / captured outbox
/data/
data/
*.db
*.db-wal
*.db-shm
outbox/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
uv.lock.bak

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Obsidian local workspace state (the vault itself IS committed)
knowledge-base/.obsidian/workspace*.json
knowledge-base/.obsidian/cache
