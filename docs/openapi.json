    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness plus dependency reachability",
        "description": "Liveness, plus the reachability of Stripe, Anthropic and the gateway.\n\nMissing credentials are reported as ``not_configured`` rather than as failures, so a\nreviewer can see exactly which key is absent instead of a generic red light.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApproveRequest": {
        "properties": {
          "actor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor",
            "description": "Defaults to the operator identity."
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "edited_body": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100000
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Body",
            "description": "If present, this text is stored on the approval record and the payload hash is recomputed from it BEFORE the token is minted. The operator approves what they actually read."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ApproveRequest"
      },
      "AuditPage": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/AuditRow"
            },
            "type": "array",
            "title": "Events"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "chain": {
            "$ref": "#/components/schemas/ChainReport"
          }
        },
        "type": "object",
        "required": [
          "events",
          "total",
          "limit",
          "offset",
          "chain"
        ],
        "title": "AuditPage"
      },
      "AuditRow": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "event": {
            "type": "string",
            "title": "Event"
          },
          "subject_type": {
            "type": "string",
            "title": "Subject Type"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          },
          "prev_hash": {
            "type": "string",
            "title": "Prev Hash"
          },
          "hash": {
            "type": "string",
            "title": "Hash"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ts",
          "actor",
          "event",
          "subject_type",
          "subject_id",
          "prev_hash",
          "hash"
        ],
        "title": "AuditRow"
      },
      "ChainReport": {
        "properties": {
          "intact": {
            "type": "boolean",
            "title": "Intact"
          },
          "length": {
            "type": "integer",
            "title": "Length"
          },
          "head_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Head Hash"
          },
          "broken_at_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broken At Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "intact",
          "length"
        ],
        "title": "ChainReport"
      },
      "DecisionResponse": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "gateway": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GatewayReport"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "proposal_id",
          "decision",
          "status"
        ],
        "title": "DecisionResponse"
      },
      "GatewayReport": {
        "properties": {
          "executed": {
            "type": "boolean",
            "title": "Executed"
          },
          "http_status": {
            "type": "integer",
            "title": "Http Status"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "error_code": {
            "anyOf": [
