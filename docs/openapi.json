              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/proposals/{proposal_id}/approve": {
      "post": {
        "tags": [
          "proposals"
        ],
        "summary": "Approve Proposal",
        "description": "Record the approval, mint the token, call the gateway, return the outcome.\n\nIf ``edited_body`` is present the payload hash is recomputed from it before the token is\nminted, so the token authorises what the operator actually read.\n\nA gateway refusal is answered with the gateway's own status code. The approval itself is\nstill recorded: a human decided, and the gateway declining to act on it does not unmake\nthat.",
        "operationId": "approve_proposal_v1_proposals__proposal_id__approve_post",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Proposal Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/proposals/{proposal_id}/reject": {
      "post": {
        "tags": [
          "proposals"
        ],
        "summary": "Reject Proposal",
        "description": "Terminal. A note is required.",
        "operationId": "reject_proposal_v1_proposals__proposal_id__reject_post",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Proposal Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/proposals/{proposal_id}/edit": {
      "post": {
        "tags": [
          "proposals"
        ],
        "summary": "Save Edit",
        "description": "Save an edited letter and re-hash it. Any earlier token can no longer execute.",
        "operationId": "save_edit_v1_proposals__proposal_id__edit_post",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Proposal Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveEditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Save Edit V1 Proposals  Proposal Id  Edit Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/proposals/{proposal_id}/attempt-unapproved": {
      "post": {
        "tags": [
          "proposals"
        ],
        "summary": "Attempt Unapproved",
        "description": "Ask the gateway to send a letter nobody approved. It refuses. Nothing is sent.\n\nStep 4 of the handoff demo, and acceptance criterion 5. The token is correctly signed:\nthe refusal comes from the gateway reading this proposal's status out of its own\ndatabase, which is the claim this architecture makes. See app/approval/probe.py.\n\nIt cannot call the gateway from the browser, because the gateway publishes no port --\nthat is criterion 7 -- so the call is made here, on the internal network.",
        "operationId": "attempt_unapproved_v1_proposals__proposal_id__attempt_unapproved_post",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Proposal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "403": {
            "description": "not_approved -- the expected outcome"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/invoices/overdue": {
